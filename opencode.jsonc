{
  "$schema": "https://opencode.ai/config.json",

  // Keep unattended sandboxes deterministic and credential-free by default.
  "model": "opencode/big-pickle",
  "autoupdate": false,
  "share": "disabled",

  // Optional local tooling. These servers do not contain credentials or host-specific paths.
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 60000
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },

  "provider": {
    "openai": {
      "models": {
        "gpt-5.4-mini": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "github-copilot": {
      "models": {
        "gpt-5.4-mini": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  }
}
